LOCAL_DOMAIN={{mastodon_domain}}
WEB_DOMAIN={{mastodon_public_hostname}}

SINGLE_USER_MODE=true

SECRET_KEY_BASE={{secret_key_base}}
OTP_SECRET={{otp_secret}}

VAPID_PRIVATE_KEY={{vapid_private_key}}
VAPID_PUBLIC_KEY={{vapid_public_key}}

DB_HOST={{ 'db' if mastodon_postgres_enabled | bool else '/var/run/postgresql' }}
DB_NAME=mastodon
DB_USER=mastodon
DB_PASS={{ mastodon_postgres_password }}

{% if mastodon_redis_enabled | bool %}
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
{% endif %}

SMTP_SERVER={{ mastodon_smtp_host }}
SMTP_PORT={{ mastodon_smtp_port }}
SMTP_LOGIN={{ mastodon_smtp_user }}
SMTP_PASSWORD="{{ mastodon_smtp_password }}"
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_AUTH_METHOD=plain
SMTP_OPENSSL_VERIFY_MODE=peer
SMTP_FROM_ADDRESS=Mastodon <{{ mastodon_email_sender }}>

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY={{ active_record_encryption.primary_key }}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY={{ active_record_encryption.deterministic_key }}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT={{ active_record_encryption.key_derivation_salt }}
